---
import type { AdminArticle } from '../article/types';

interface Props {
  article?: AdminArticle;
  apiBase: string;
}
const { article, apiBase } = Astro.props;
const lockedSlug = Boolean(article?.published_at);
const tags = article?.tags.map((tag) => tag.name).join(', ') ?? '';
---

<form class="editor" data-article-id={article?.id ?? ''} data-api-base={apiBase} data-slug-locked={lockedSlug ? 'true' : 'false'} aria-busy="false" novalidate>
  <p class="editor-status" role="status" aria-live="polite" data-editor-status></p>
  <div class="editor-fields">
    <label class="editor-field--wide">Tiêu đề
      <input name="title" required value={article?.title ?? ''} autocomplete="off" />
    </label>
    <label>Slug
      <input name="slug" value={article?.slug ?? ''} pattern="[a-z0-9]+(-[a-z0-9]+)*" disabled={lockedSlug} aria-describedby={lockedSlug ? 'slug-locked-note' : undefined} />
    </label>
    {lockedSlug && <p id="slug-locked-note" class="article-list__meta editor-field--wide">Slug được khóa sau lần xuất bản đầu tiên để bảo vệ liên kết.</p>}
    <label class="editor-field--wide">Tóm tắt
      <textarea name="excerpt" required>{article?.excerpt ?? ''}</textarea>
    </label>
    <label>URL ảnh bìa
      <input name="cover_image_url" type="url" value={article?.cover_image_url ?? ''} placeholder="https://example.com/anh-bia.jpg" />
    </label>
    <label>Thẻ <span id="tags-note" class="article-list__meta">(ngăn cách bằng dấu phẩy)</span>
      <input name="tags" value={tags} aria-describedby="tags-note" />
    </label>
  </div>
  <div class="editor-workspace">
    <label>Nội dung Markdown
      <textarea class="editor-content" name="content_markdown" required>{article?.content_markdown ?? ''}</textarea>
    </label>
    <section class="editor-preview" aria-labelledby="preview-title" hidden data-preview>
      <h2 id="preview-title">Xem trước</h2>
      <div class="article-content" data-preview-content></div>
    </section>
  </div>
  <div class="editor-buttons">
    <button type="button" class="secondary" data-action="preview">Xem trước</button>
    <button type="button" class="secondary" data-action="draft">Lưu nháp</button>
    <button type="button" data-action="published">Xuất bản</button>
    {article && <button type="button" class="danger" data-action="delete">Xóa vĩnh viễn</button>}
  </div>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>('.editor');
  if (form) {
    const apiBase = form.dataset.apiBase ?? '';
    const articleID = form.dataset.articleId ?? '';
    const slugLocked = form.dataset.slugLocked === 'true';
    const status = form.querySelector<HTMLElement>('[data-editor-status]')!;
    const preview = form.querySelector<HTMLElement>('[data-preview]')!;
    const previewContent = form.querySelector<HTMLElement>('[data-preview-content]')!;
    const title = form.elements.namedItem('title') as HTMLInputElement;
    const slug = form.elements.namedItem('slug') as HTMLInputElement;
    const actionButtons = [...form.querySelectorAll<HTMLButtonElement>('[data-action]')];
    const buttonLabels = new Map(actionButtons.map((button) => [button, button.textContent?.trim() ?? '']));
    const loadingMessage = (action: string) => ({ preview: 'Đang tạo bản xem trước…', draft: 'Đang lưu nháp…', published: 'Đang xuất bản…', delete: 'Đang xóa bài viết…' }[action] ?? 'Đang xử lý…');
    const setBusy = (button: HTMLButtonElement, busy: boolean) => {
      form.setAttribute('aria-busy', String(busy));
      actionButtons.forEach((actionButton) => {
        actionButton.disabled = busy;
        actionButton.textContent = busy && actionButton === button
          ? loadingMessage(actionButton.dataset.action ?? '')
          : buttonLabels.get(actionButton) ?? '';
      });
      if (busy) {
        status.setAttribute('role', 'status');
        status.textContent = loadingMessage(button.dataset.action ?? '');
      }
    };
    let dirty = false;
    let manuallyEditedSlug = Boolean(slug.value);

    const slugify = (value: string) => value.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/đ/g, 'd').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
    title.addEventListener('input', () => { if (!manuallyEditedSlug && !slugLocked) slug.value = slugify(title.value); });
    slug.addEventListener('input', () => { manuallyEditedSlug = slug.value.length > 0; });
    form.addEventListener('input', () => { dirty = true; });
    window.addEventListener('beforeunload', (event) => { if (dirty) { event.preventDefault(); } });

    const payload = (articleStatus: 'draft' | 'published') => ({
      title: title.value,
      slug: slug.value,
      excerpt: (form.elements.namedItem('excerpt') as HTMLTextAreaElement).value,
      content_markdown: (form.elements.namedItem('content_markdown') as HTMLTextAreaElement).value,
      cover_image_url: (form.elements.namedItem('cover_image_url') as HTMLInputElement).value || null,
      tags: (form.elements.namedItem('tags') as HTMLInputElement).value.split(',').map((tag) => tag.trim()).filter(Boolean),
      status: articleStatus,
    });
    const callAPI = async (path: string, method: string, body?: unknown) => {
      const response = await fetch(`${apiBase}${path}`, { method, headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: body === undefined ? undefined : JSON.stringify(body) });
      if (response.status === 204) return undefined;
      const result = await response.json();
      if (!response.ok) throw new Error(result.error?.message ?? 'Thao tác không thành công.');
      return result;
    };
    const showError = (error: unknown) => {
      status.setAttribute('role', 'alert');
      status.textContent = error instanceof Error ? error.message : 'Thao tác không thành công. Vui lòng thử lại.';
    };

    actionButtons.forEach((button) => button.addEventListener('click', async () => {
      const action = button.dataset.action;
      if (!action || button.disabled) return;
      if (action === 'delete' && !window.confirm('Xóa vĩnh viễn bài viết này? Thao tác này không thể hoàn tác.')) return;
      setBusy(button, true);
      try {
        if (action === 'preview') {
          const result = await callAPI('/admin/markdown/preview', 'POST', { content_markdown: (form.elements.namedItem('content_markdown') as HTMLTextAreaElement).value });
          previewContent.innerHTML = result.data.html;
          preview.hidden = false;
          status.setAttribute('role', 'status');
          status.textContent = `Xem trước · ${result.data.reading_minutes} phút đọc.`;
          return;
        }
        if (action === 'delete') {
          await callAPI(`/admin/articles/${articleID}`, 'DELETE');
          dirty = false;
          window.location.assign('/quan-tri/bai-viet');
          return;
        }
        const articleStatus = action === 'published' ? 'published' : 'draft';
        const result = await callAPI(articleID ? `/admin/articles/${articleID}` : '/admin/articles', articleID ? 'PUT' : 'POST', payload(articleStatus));
        dirty = false;
        if (!articleID) { window.location.assign(`/quan-tri/bai-viet/${result.data.id}`); return; }
        if (articleStatus === 'published') { window.location.reload(); return; }
        status.setAttribute('role', 'status');
        status.textContent = 'Đã lưu nháp.';
      } catch (error) {
        showError(error);
      } finally {
        setBusy(button, false);
      }
    }));
  }
</script>
