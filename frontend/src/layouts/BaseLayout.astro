---
import ThemeToggle from '../components/ThemeToggle.astro';
import { canonicalURL, site } from '../lib/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string | null;
  type?: 'website' | 'article';
}
const { title, description = site.description, image, type = 'website' } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : site.name;
const canonical = canonicalURL(Astro.url.pathname);
const socialImage = image ? new URL(image, site.url).toString() : undefined;
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    <title>{pageTitle}</title>
    <script is:inline>
      {`try { const saved = localStorage.getItem('theme'); if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved; } catch {}`}
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="site-name" href="/">{site.name}</a>
        <nav aria-label="Điều hướng chính"><a href="/gioi-thieu">Giới thiệu</a></nav>
        <ThemeToggle />
      </div>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <p>© {new Date().getUTCFullYear()} {site.author}</p>
      {site.socialURL && <a href={site.socialURL} rel="me">Kết nối</a>}
    </footer>
  </body>
</html>
