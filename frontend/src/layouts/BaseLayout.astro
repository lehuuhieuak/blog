---
import ThemeToggle from '../components/ThemeToggle';
import { canonicalURL, site } from '../lib/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string | null;
  type?: 'website' | 'article';
  width?: 'reading' | 'wide';
}
const { title, description = site.description, image, type = 'website', width = 'reading' } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : site.name;
const canonical = canonicalURL(Astro.url.pathname);
const socialImage = image ? new URL(image, site.url).toString() : undefined;
const isHome = Astro.url.pathname === '/';
const isAbout = Astro.url.pathname === '/gioi-thieu';
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    <title>{pageTitle}</title>
    <script is:inline>
      try { const saved = localStorage.getItem('theme'); const dark = saved === 'dark' || (!saved && window.matchMedia('(prefers-color-scheme: dark)').matches); document.documentElement.classList.toggle('dark', dark); } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Chuyển đến nội dung chính</a>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="site-name" href="/" aria-current={isHome ? 'page' : undefined}>{site.name}</a>
        <nav class="site-nav" aria-label="Điều hướng chính"><a href="/gioi-thieu" aria-current={isAbout ? 'page' : undefined}>Giới thiệu</a></nav>
        <ThemeToggle client:load />
      </div>
    </header>
    <main id="main-content" class:list={['page-shell', `page-shell--${width}`]} tabindex="-1"><slot /></main>
    <footer class="site-footer">
      <p>© {new Date().getUTCFullYear()} {site.author}</p>
      {site.socialURL && <a href={site.socialURL} rel="me">Kết nối</a>}
    </footer>
  </body>
</html>
