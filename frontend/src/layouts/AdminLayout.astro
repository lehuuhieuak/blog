---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle';
import { Alert, AlertDescription, AlertTitle } from '@/components/ui/alert';
import { site } from '../lib/site';

interface Props { title: string }
const { title } = Astro.props;
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex,nofollow" />
    <title>{title} · Quản trị · {site.name}</title>
    <script is:inline>try { const saved = localStorage.getItem('theme'); const dark = saved === 'dark' || (!saved && window.matchMedia('(prefers-color-scheme: dark)').matches); document.documentElement.classList.toggle('dark', dark); } catch {}</script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Chuyển đến nội dung chính</a>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="site-name" href="/quan-tri/bai-viet">Quản trị bài viết</a>
        <nav class="site-nav" aria-label="Điều hướng quản trị"><a href="/quan-tri/bai-viet/moi" aria-current={Astro.url.pathname === '/quan-tri/bai-viet/moi' ? 'page' : undefined}>Bài viết mới</a></nav>
        <ThemeToggle client:load />
      </div>
    </header>
    <main id="main-content" class="page-shell page-shell--wide" tabindex="-1">
      <Alert className="admin-warning mb-8" role="status"><AlertTitle>Khu vực quản trị chưa có xác thực</AlertTitle><AlertDescription>Không chia sẻ URL này trên môi trường công khai.</AlertDescription></Alert>
      <slot />
    </main>
  </body>
</html>
