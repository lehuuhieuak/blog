---
import '../styles/global.css';
import { site } from '../lib/site';

interface Props { title: string }
const { title } = Astro.props;
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex,nofollow" />
    <title>{title} · Quản trị · {site.name}</title>
    <script is:inline>{`try { const saved = localStorage.getItem('theme'); if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved; } catch {}`}</script>
  </head>
  <body>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="site-name" href="/quan-tri/bai-viet">Quản trị bài viết</a>
        <a href="/quan-tri/bai-viet/moi">Bài viết mới</a>
      </div>
    </header>
    <main>
      <p class="admin-warning" role="status">Khu vực quản trị hiện chưa có xác thực. Không chia sẻ URL này trên môi trường công khai.</p>
      <slot />
    </main>
  </body>
</html>
