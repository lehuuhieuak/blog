---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import { site } from '../lib/site';

interface Props { title: string }
const { title } = Astro.props;
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex,nofollow" />
    <title>{title} · Quản trị · {site.name}</title>
    <script is:inline>try { const saved = localStorage.getItem('theme'); if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved; } catch {}</script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Chuyển đến nội dung chính</a>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="site-name" href="/quan-tri/bai-viet">Quản trị bài viết</a>
        <nav class="site-nav" aria-label="Điều hướng quản trị"><a href="/quan-tri/bai-viet/moi" aria-current={Astro.url.pathname === '/quan-tri/bai-viet/moi' ? 'page' : undefined}>Bài viết mới</a></nav>
        <ThemeToggle />
      </div>
    </header>
    <main id="main-content" class="page-shell page-shell--wide" tabindex="-1">
      <p class="admin-warning" role="status">Khu vực quản trị hiện chưa có xác thực. Không chia sẻ URL này trên môi trường công khai.</p>
      <slot />
    </main>
  </body>
</html>
