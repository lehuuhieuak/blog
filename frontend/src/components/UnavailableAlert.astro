---
import { Alert, AlertDescription, AlertTitle } from '@/components/ui/alert';

interface Props {
  title?: string;
  message: string;
}
const { title = 'Tạm thời không khả dụng', message } = Astro.props;
---

<Alert className="empty-state" role="status">
  <AlertTitle>{title}</AlertTitle>
  <AlertDescription>{message}</AlertDescription>
</Alert>
