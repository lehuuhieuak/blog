---
import ArticleList from '../features/article/ArticleList.astro';
import type { ArticleSummary } from "../features/article/types";
import BaseLayout from '../layouts/BaseLayout.astro';
import Pagination from '../components/Pagination.astro';
import { APIError, listArticles } from '../lib/api';

const requestedPage = Number(Astro.url.searchParams.get('page') ?? '1');
const page = Number.isInteger(requestedPage) && requestedPage > 0 ? requestedPage : 1;
let articles: ArticleSummary[] = [];
let meta = { page, page_size: 10, total: 0, total_pages: 0 };
let unavailable = false;
try {
  const result = await listArticles(page);
  articles = result.data;
  meta = result.meta;
} catch (error) {
  unavailable = !(error instanceof APIError && error.status === 404);
  Astro.response.status = 503;
}
---

<BaseLayout>
  <section aria-labelledby="latest-title">
    <p class="eyebrow">Ghi chép mới</p>
    <h1 id="latest-title">Bài viết gần đây</h1>
    {unavailable ? <p class="empty-state">Chưa thể tải bài viết. Vui lòng thử lại sau.</p> : <ArticleList articles={articles} />}
    {!unavailable && <Pagination pathname="/" current={meta.page} total={meta.total_pages} />}
  </section>
</BaseLayout>
