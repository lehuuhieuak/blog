---
import ArticleList from '../../features/article/ArticleList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { ArticleSummary } from "../../features/article/types";
import Pagination from '../../components/Pagination.astro';
import { APIError, listArticles, listTags } from '../../lib/api';

const slug = Astro.params.slug ?? '';
const requestedPage = Number(Astro.url.searchParams.get('page') ?? '1');
const page = Number.isInteger(requestedPage) && requestedPage > 0 ? requestedPage : 1;
let articles: ArticleSummary[] = [];
let meta = { page, page_size: 10, total: 0, total_pages: 0 };
let tagName = slug;
let unavailable = false;
try {
  const [result, tags] = await Promise.all([listArticles(page, slug), listTags()]);
  articles = result.data;
  meta = result.meta;
  tagName = tags.data.find((tag) => tag.slug === slug)?.name ?? slug;
} catch (error) {
  unavailable = !(error instanceof APIError && error.status === 404);
  Astro.response.status = 503;
}
---

<BaseLayout title={`Thẻ ${tagName}`}>
  <section aria-labelledby="tag-title">
    <p class="eyebrow">Thẻ</p>
    <h1 id="tag-title">#{tagName}</h1>
    {unavailable ? <p class="empty-state">Chưa thể tải bài viết. Vui lòng thử lại sau.</p> : <ArticleList articles={articles} />}
    {!unavailable && <Pagination pathname={`/the/${slug}`} current={meta.page} total={meta.total_pages} />}
  </section>
</BaseLayout>
