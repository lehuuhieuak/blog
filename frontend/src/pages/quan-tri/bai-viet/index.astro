---
import { Alert, AlertDescription, AlertTitle } from '@/components/ui/alert';
import { Badge } from '@/components/ui/badge';
import {
  Table,
  TableBody,
  TableCell,
  TableHead,
  TableHeader,
  TableRow,
} from '@/components/ui/table';
import LinkButton from '@/components/LinkButton';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import Pagination from '../../../components/Pagination.astro';
import type { AdminArticle, ListResponse } from "../../../features/article/types";
import { APIError, listAdminArticles } from '../../../lib/api';

const requestedPage = Number(Astro.url.searchParams.get('page') ?? '1');
const page = Number.isInteger(requestedPage) && requestedPage > 0 ? requestedPage : 1;
const status = Astro.url.searchParams.get('status') === 'published' ? 'published' : Astro.url.searchParams.get('status') === 'draft' ? 'draft' : undefined;
let result: ListResponse<AdminArticle> = { data: [], meta: { page, page_size: 10, total: 0, total_pages: 0 } };
let unavailable = false;
try { result = await listAdminArticles(page, status); } catch (error) { unavailable = !(error instanceof APIError && error.status === 404); Astro.response.status = 503; }
const query = status ? `?status=${status}` : '';
const formatter = new Intl.DateTimeFormat('vi-VN', { dateStyle: 'short', timeZone: 'UTC' });
---

<AdminLayout title="Bài viết">
  <div class="admin-actions flex flex-wrap items-center justify-between gap-4">
    <h1 class="m-0">Bài viết</h1>
    <LinkButton href="/quan-tri/bai-viet/moi" size="lg">Tạo bài viết</LinkButton>
  </div>
  <nav class="admin-filters mb-6 flex flex-wrap gap-2" aria-label="Lọc bài viết">
    <LinkButton href="/quan-tri/bai-viet" variant={status === undefined ? 'default' : 'outline'} size="sm" aria-current={status === undefined ? 'page' : undefined}>Tất cả</LinkButton>
    <LinkButton href="/quan-tri/bai-viet?status=draft" variant={status === 'draft' ? 'default' : 'outline'} size="sm" aria-current={status === 'draft' ? 'page' : undefined}>Nháp</LinkButton>
    <LinkButton href="/quan-tri/bai-viet?status=published" variant={status === 'published' ? 'default' : 'outline'} size="sm" aria-current={status === 'published' ? 'page' : undefined}>Đã xuất bản</LinkButton>
  </nav>
  {unavailable ? (
    <Alert className="empty-state" role="status">
      <AlertTitle>Không thể tải danh sách</AlertTitle>
      <AlertDescription>Vui lòng thử lại sau.</AlertDescription>
    </Alert>
  ) : (
    <div class="admin-table-scroll" tabindex="0" role="region" aria-label="Danh sách bài viết">
      <Table className="admin-list min-w-[44rem]">
        <TableHeader><TableRow><TableHead scope="col">Tiêu đề</TableHead><TableHead scope="col">Trạng thái</TableHead><TableHead scope="col">Cập nhật</TableHead></TableRow></TableHeader>
        <TableBody>{result.data.map((article) => <TableRow><TableCell><a href={`/quan-tri/bai-viet/${article.id}`}>{article.title}</a></TableCell><TableCell><Badge variant={article.status === 'published' ? 'default' : 'outline'}>{article.status === 'published' ? 'Đã xuất bản' : 'Nháp'}</Badge></TableCell><TableCell><time datetime={article.updated_at}>{formatter.format(new Date(article.updated_at))}</time></TableCell></TableRow>)}</TableBody>
      </Table>
    </div>
  )}
  {!unavailable && <Pagination pathname={`/quan-tri/bai-viet${query}`} current={result.meta.page} total={result.meta.total_pages} />}
</AdminLayout>
