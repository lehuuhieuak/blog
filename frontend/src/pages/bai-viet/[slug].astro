---
import { Badge } from "@/components/ui/badge";
import NotFound from '../../components/NotFound.astro';
import ArticleTOC from '../../components/ArticleTOC.astro';
import UnavailableAlert from '../../components/UnavailableAlert.astro';
import { APIError, getArticle } from '../../lib/api';
import { canonicalURL, site } from '../../lib/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { PublicArticle } from '../../features/article/types';

let article: PublicArticle | undefined;
let unavailable = false;
try {
  article = (await getArticle(Astro.params.slug ?? '')).data;
} catch (error) {
  if (error instanceof APIError && error.status === 404) Astro.response.status = 404;
  else { Astro.response.status = 503; unavailable = true; }
}
const formatter = new Intl.DateTimeFormat('vi-VN', { dateStyle: 'long', timeZone: 'UTC' });
const isUpdated = article?.published_at && new Date(article.updated_at).getTime() > new Date(article.published_at).getTime();
const tableOfContents = article?.table_of_contents ?? [];
const jsonLD = article ? JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: article.title,
  description: article.excerpt,
  datePublished: article.published_at,
  dateModified: article.updated_at,
  mainEntityOfPage: canonicalURL(Astro.url.pathname),
  author: { '@type': 'Person', name: site.author },
  image: article.cover_image_url ?? undefined,
}).replace(/</g, '\\u003c') : '';
---

{article ? (
  <BaseLayout title={article.title} description={article.excerpt} image={article.cover_image_url} type="article" width="wide">
    <div class="article-layout">
      {tableOfContents.length > 0 && <ArticleTOC items={tableOfContents} collapsible />}
      <article>
        <header class="article-header">
          <p class="eyebrow">{article.published_at && <time datetime={article.published_at}>{formatter.format(new Date(article.published_at))}</time>} · {article.reading_minutes} phút đọc</p>
          <h1>{article.title}</h1>
          <p class="article-excerpt">{article.excerpt}</p>
          {article.tags.length > 0 && <ul class="tag-list" aria-label="Thẻ">{article.tags.map((tag) => <li><a href={`/the/${tag.slug}`}><Badge variant="outline">#{tag.name}</Badge></a></li>)}</ul>}
          {isUpdated && <p class="article-list__meta">Cập nhật: <time datetime={article.updated_at}>{formatter.format(new Date(article.updated_at))}</time></p>}
        </header>
        {article.cover_image_url && <img class="article-cover" src={article.cover_image_url} alt="" />}
        <div class="article-content" set:html={article.content_html}></div>
      </article>
      {tableOfContents.length > 0 && (
        <aside class="article-layout__toc"><ArticleTOC items={tableOfContents} /></aside>
      )}
    </div>
    <script>
      const tocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
      const headings = Array.from(document.querySelectorAll<HTMLElement>('.article-content h2[id], .article-content h3[id]'))
        .filter((heading) => tocLinks.some((link) => link.dataset.tocTarget === heading.id));

      if (tocLinks.length > 0 && headings.length > 0) {
        const readingMarker = Number.parseFloat(getComputedStyle(document.documentElement).fontSize) * 6;
        let activeID: string | undefined;

        const syncActiveTOC = () => {
          let currentHeading: HTMLElement | undefined;
          for (const heading of headings) {
            if (heading.getBoundingClientRect().top <= readingMarker) currentHeading = heading;
            else break;
          }

          const nextActiveID = currentHeading?.id;
          if (nextActiveID === activeID) return;
          activeID = nextActiveID;

          for (const link of tocLinks) {
            const isActive = link.dataset.tocTarget === activeID;
            link.classList.toggle('toc__link--active', isActive);
            if (isActive) link.setAttribute('aria-current', 'location');
            else link.removeAttribute('aria-current');
          }
        };

        let animationFrame: number | undefined;
        const scheduleTOCSync = () => {
          if (animationFrame !== undefined) return;
          animationFrame = requestAnimationFrame(() => {
            animationFrame = undefined;
            syncActiveTOC();
          });
        };

        const observer = new IntersectionObserver(scheduleTOCSync, {
          rootMargin: `-${readingMarker}px 0px 0px`,
          threshold: 0,
        });
        headings.forEach((heading) => observer.observe(heading));

        scheduleTOCSync();
        window.addEventListener('scroll', scheduleTOCSync, { passive: true });
        window.addEventListener('hashchange', scheduleTOCSync);
      }
    </script>
    <script is:inline type="application/ld+json" set:html={jsonLD}></script>
  </BaseLayout>
) : (
  <BaseLayout title={unavailable ? 'Tạm thời không khả dụng' : 'Không tìm thấy'}>
    {unavailable ? <UnavailableAlert message="Chưa thể tải bài viết. Vui lòng thử lại sau." /> : <NotFound />}
  </BaseLayout>
)}
