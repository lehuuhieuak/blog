# This file lives only on the production server as /etc/minimal-blog/runtime.env.
# URL-encode reserved characters in the PostgreSQL password.
DATABASE_URL=postgres://blog:replace-with-a-secret@host.docker.internal:5432/blog?sslmode=disable
CORS_ALLOWED_ORIGIN=https://blog.example.com
API_PORT=8080
WEB_PORT=4321
